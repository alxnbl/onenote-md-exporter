<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pure unit tests for the link-resolution logic (Services/Export/LinkRepairCore.cs). That part has no OneNote
    and no Models dependency, so its source is compiled straight into this project and the tests run with no
    OneNote and no Visual Studio ("dotnet test src/LinkRepair.Tests").
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>alxnbl.OneNoteMdExporter.Tests</RootNamespace>
    <AssemblyName>LinkRepair.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\OneNoteMdExporter\Services\Export\LinkRepairCore.cs" Link="LinkRepairCore.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NUnit" Version="4.1.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
  </ItemGroup>

</Project>
